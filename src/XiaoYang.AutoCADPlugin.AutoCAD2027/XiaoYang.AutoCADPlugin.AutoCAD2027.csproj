<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MrZ.XiaoYangRadialMenu.AutoCAD2027</AssemblyName>
    <RootNamespace>XiaoYang.AutoCADPlugin</RootNamespace>
    <Version>2.2.0.84</Version>
    <AssemblyVersion>2.2.0.84</AssemblyVersion>
    <FileVersion>2.2.0.84</FileVersion>
    <InformationalVersion>2.2.0.84</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649;CS8632;WFO1000</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\XiaoYang.AutoCADPlugin\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\XiaoYang.AutoCADPlugin\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <Target Name="CopyToBundle" AfterTargets="Build">
    <PropertyGroup>
      <BundleOutput>$(MSBuildProjectDirectory)\..\..\packaging\XY-CAD-H.bundle\Contents\Net10</BundleOutput>
    </PropertyGroup>
    <MakeDir Directories="$(BundleOutput)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BundleOutput)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(BundleOutput)" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>
</Project>
