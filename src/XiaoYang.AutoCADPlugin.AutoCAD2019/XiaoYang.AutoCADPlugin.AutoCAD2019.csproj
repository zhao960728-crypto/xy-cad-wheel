<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MrZ.XiaoYangRadialMenu.AutoCAD2019</AssemblyName>
    <RootNamespace>XiaoYang.AutoCADPlugin</RootNamespace>
    <Version>2.2.0.84</Version>
    <AssemblyVersion>2.2.0.84</AssemblyVersion>
    <FileVersion>2.2.0.84</FileVersion>
    <InformationalVersion>2.2.0.84</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649;CS8632</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\XiaoYang.AutoCADPlugin\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\XiaoYang.AutoCADPlugin\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <PackageReference Include="AutoCAD.NET" Version="23.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <Target Name="CopyToBundle" AfterTargets="Build">
    <PropertyGroup><BundleOutput>$(MSBuildProjectDirectory)\..\..\packaging\XY-CAD-H.bundle\Contents\NetFramework48</BundleOutput></PropertyGroup>
    <MakeDir Directories="$(BundleOutput)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BundleOutput)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(BundleOutput)" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>
</Project>
