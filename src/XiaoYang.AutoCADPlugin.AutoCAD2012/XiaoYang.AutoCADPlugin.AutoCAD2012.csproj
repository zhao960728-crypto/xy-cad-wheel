<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MrZ.XiaoYangRadialMenu.AutoCAD2012</AssemblyName><RootNamespace>XiaoYang.AutoCADPlugin</RootNamespace>
    <Version>2.2.0.84</Version><AssemblyVersion>2.2.0.84</AssemblyVersion><FileVersion>2.2.0.84</FileVersion><InformationalVersion>2.2.0.84</InformationalVersion><LangVersion>latest</LangVersion><NoWarn>$(NoWarn);CS0649;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);AUTOCAD_LEGACY_EDITOR;AUTOCAD_PRE2013;AUTOCAD_CLR2</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../XiaoYang.AutoCADPlugin.LegacySupport/LegacyRuntime.cs" /><Compile Include="../XiaoYang.AutoCADPlugin.LegacySupport/LegacyZipArchive.cs" /><Compile Include="../XiaoYang.AutoCADPlugin.LegacySupport/LegacyUpdateDialog.cs" />
    <Compile Include="../XiaoYang.AutoCADPlugin/Properties/AssemblyInfo.cs" />
    <PackageReference Include="AutoCAD-2011.Net.Base" Version="1.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Theraot.Core" Version="3.2.11" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <Target Name="PrepareLegacy" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\XiaoYang.AutoCADPlugin.LegacySupport\prepare-sources.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\obj\legacy-$(Configuration)&quot;" />
    <ItemGroup><Compile Include="obj/legacy-$(Configuration)/*.cs" /></ItemGroup>
  </Target>
<Target Name="CopyToBundle" AfterTargets="Build"><PropertyGroup><BundleOutput>$(MSBuildProjectDirectory)\..\..\packaging\XY-CAD-H.bundle\Contents\NetFramework35</BundleOutput></PropertyGroup><MakeDir Directories="$(BundleOutput)" /><Copy SourceFiles="$(TargetPath);$(TargetDir)Theraot.Core.dll" DestinationFolder="$(BundleOutput)" /></Target></Project>
