<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/XiaoYang.AutoCADPlugin/PluginUpdateService.cs" Link="PluginUpdateService.cs" />
    <Compile Include="../../src/XiaoYang.AutoCADPlugin/LanzouUpdateSource.cs" Link="LanzouUpdateSource.cs" />
    <Compile Include="../../src/XiaoYang.AutoCADPlugin/JsonCompat.cs" Link="JsonCompat.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
</Project>
