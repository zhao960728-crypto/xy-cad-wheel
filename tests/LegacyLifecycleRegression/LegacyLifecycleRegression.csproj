<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;CS0649;CS8632</NoWarn>
    <DefineConstants>$(DefineConstants);EXTENSION_SELECTION_TEST</DefineConstants>
    <DefineConstants Condition="'$(ModernHost)' != 'true'">$(DefineConstants);AUTOCAD_CLR2</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../WheelCommandRegression/Stubs.cs" Link="Stubs.cs" />
    <Compile Include="../../src/XiaoYang.AutoCADPlugin/CadCommandExecutor.cs" Link="CadCommandExecutor.cs" />
    <Compile Include="../../src/XiaoYang.AutoCADPlugin/ExtensionLoadService.cs" Link="ExtensionLoadService.cs" />
    <Compile Include="../../src/XiaoYang.AutoCADPlugin.LegacySupport/LegacyDeferredStartup.cs" Link="LegacyDeferredStartup.cs" />
  </ItemGroup>
</Project>
